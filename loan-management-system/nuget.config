<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Scopes NuGet to nuget.org for this POC and silences NU1507 (multiple sources)
    under central package management. Overrides any inherited machine/user sources.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
